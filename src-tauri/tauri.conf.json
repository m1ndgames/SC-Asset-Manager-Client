{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SC Asset Manager Client",
  "version": "0.1.0",
  "identifier": "org.scassetmanager.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SC Asset Manager \u2014 Log Watcher",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#000b11"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBM0Q2OUEwMkYzODdFRUUKUldUdWZqZ3ZvR2s5V3ZxZVUxeExTY1BGV2hJRjdkcjBOVmdUUDViSUVMVVNBcXBvQkhRakxXR0cK",
      "endpoints": [
        "https://github.com/m1ndgames/SC-Asset-Manager-Client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
